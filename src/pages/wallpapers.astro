---
import Layout from '@/layouts/Layout.astro'
import PageHead from '@/components/PageHead.astro'
import WallpaperGalleryClient from '@/components/wallpapers/WallpaperGalleryClient'
---

<Layout class="max-w-4xl">
  <PageHead
    slot="head"
    title="Wallpapers"
    description="Cloudinary wallpaper gallery"
  />

  <section class="mb-2 space-y-2 text-center">
    <h1 class="text-4xl font-bold bg-gradient-to-r from-foreground to-muted-foreground bg-clip-text text-transparent">
      Wallpapers
    </h1>
  </section>

  <WallpaperGalleryClient client:load />
</Layout>
