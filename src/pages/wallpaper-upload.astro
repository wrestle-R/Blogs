---
import Layout from '@/layouts/Layout.astro'
import PageHead from '@/components/PageHead.astro'
import WallpaperUploadClient from '@/components/wallpapers/WallpaperUploadClient'
---

<Layout class="max-w-5xl">
  <PageHead
    slot="head"
    title="Wallpaper Upload"
    description="Upload exact 1920x1200 wallpapers to Cloudinary"
  />

  <section class="relative overflow-hidden rounded-2xl border bg-gradient-to-br from-muted/50 via-background to-muted/20 p-6">
    <div class="pointer-events-none absolute -bottom-20 -left-16 h-56 w-56 rounded-full bg-primary/10 blur-3xl"></div>
    <div class="space-y-3">
      <p class="inline-flex rounded-full border bg-background/80 px-3 py-1 text-xs font-medium text-muted-foreground">
        Public Upload
      </p>
      <h1 class="text-3xl font-bold md:text-4xl">Wallpaper Upload</h1>
      <p class="max-w-2xl text-sm text-muted-foreground">
        Drop files, validate dimensions, and upload directly to Cloudinary. Only exact
        1920x1200 wallpapers are accepted.
      </p>
    </div>
  </section>

  <WallpaperUploadClient client:load />
</Layout>
