---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PostHead from '@/components/PostHead.astro'
import SubpostsHeader from '@/components/SubpostsHeader.astro'
import SubpostsSidebar from '@/components/SubpostsSidebar.astro'
import TOCHeader from '@/components/TOCHeader.astro'
import TOCSidebar from '@/components/TOCSidebar.astro'
import { badgeVariants } from '@/components/ui/badge'
import { buttonVariants } from '@/components/ui/button'
import Layout from '@/layouts/Layout.astro'
import {
  getAdjacentPosts,
  getAllPostsAndSubposts,
  getCombinedReadingTime,
  getParentId,
  getParentPost,
  getPostReadingTime,
  getSubpostCount,
  getTOCSections,
  hasSubposts,
  isSubpost,
  parseAuthors,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getAllPostsAndSubposts()
  
  return posts
    .map((post) => ({
      params: { id: post.id },
      props: post,
    }))
}

const post = Astro.props
const currentPostId = Astro.params.id
const { Content, headings } = await render(post)
const authors = await parseAuthors(post.data.authors ?? [])

const isCurrentSubpost = isSubpost(currentPostId)
const navigation = await getAdjacentPosts(currentPostId)
const parentPost = isCurrentSubpost ? await getParentPost(currentPostId) : null

const hasChildPosts = await hasSubposts(currentPostId)
const subpostCount = !isCurrentSubpost
  ? await getSubpostCount(currentPostId)
  : 0
const postReadingTime = await getPostReadingTime(currentPostId)
const combinedReadingTime =
  hasChildPosts && !isCurrentSubpost
    ? await getCombinedReadingTime(currentPostId)
    : null

const tocSections = await getTOCSections(currentPostId)
const runblogApiBaseUrl =
  import.meta.env.PUBLIC_RUNBLOG_API_BASE_URL || 'https://runny.russel.is-a.dev'
const viewTrackSlug = isCurrentSubpost ? getParentId(currentPostId) : currentPostId
const viewTrackTitle = isCurrentSubpost
  ? parentPost?.data.title || post.data.title
  : post.data.title
---

<Layout class="blog-post-main">
  <PostHead slot="head" post={post} />
  <div
    id="blog-view-tracker"
    class="hidden"
    data-slug={viewTrackSlug}
    data-title={viewTrackTitle}
    data-views-api-base={runblogApiBaseUrl}
  ></div>
  {
    (hasChildPosts || isCurrentSubpost) && (
      <SubpostsHeader
        slot="subposts-navigation"
        parentId={isCurrentSubpost ? getParentId(currentPostId) : currentPostId}
      />
    )
  }
  {
    headings?.length > 0 &&
      !(
        isCurrentSubpost &&
        headings.length === 1 &&
        headings[0].text === post.data.title
      ) && <TOCHeader slot="table-of-contents" headings={headings} />
  }

  <section
    class="blog-post-grid grid grid-cols-[minmax(0px,1fr)_min(calc(var(--breakpoint-md)-2rem),100%)_minmax(0px,1fr)] gap-y-4 sm:gap-y-6"
    style={`--reading-row: ${post.data.image ? 3 : 2}`}
  >
    <div class="col-start-2 row-start-1">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground mb-3 pb-2 border-b border-border/40">
        {
          authors.length > 0 && (
            <a href={`/authors/${authors[0].id}`} class="flex items-center gap-1.5 hover:text-foreground transition-colors">
              <Icon name="lucide:user" class="size-3.5" />
              <span>{authors[0].name}</span>
            </a>
          )
        }
        <time datetime={post.data.date.toISOString()} class="whitespace-nowrap">{formatDate(post.data.date)}</time>
        {
          postReadingTime && (
            <span class="whitespace-nowrap text-muted-foreground/80">{postReadingTime}</span>
          )
        }
      </div>
      
      <h1 data-return-home-heading class="text-2xl font-semibold text-foreground">{post.data.title}</h1>
    </div>

    {
      post.data.image && (
        <Image
          src={post.data.image}
          alt={post.data.title}
          width={1200}
          height={630}
          class="col-span-full row-start-2 mx-auto w-full max-w-5xl object-cover rounded-lg"
        />
      )
    }

    {
      tocSections.length > 0 && (
        <TOCSidebar sections={tocSections} currentPostId={currentPostId} />
      )
    }

    <article class="blog-post-content prose dark:prose-invert col-start-2 min-w-0 max-w-none">
      <div
        id="intro-top"
        aria-hidden="true"
        class="block h-0 scroll-mt-32 xl:scroll-mt-20"
      ></div>
      {
        isCurrentSubpost && (
          <div
            id="top"
            aria-hidden="true"
            class="block h-0 scroll-mt-32 xl:scroll-mt-20"
          ></div>
        )
      }
      <Content />
    </article>

    {
      (hasChildPosts || isCurrentSubpost) && (
        <SubpostsSidebar
          parentId={
            isCurrentSubpost ? getParentId(currentPostId) : currentPostId
          }
          className="w-64"
        />
      )
    }

    <div class="blog-post-return col-start-2">
      <a href="/blog" class={buttonVariants({ variant: 'outline', size: 'sm', className: 'min-h-11' })}>
        <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
        Back to Blogs
      </a>
    </div>
  </section>

  <script>
    const trackBlogView = async () => {
      const tracker = document.getElementById('blog-view-tracker')
      if (!tracker) return

      const slug = tracker.getAttribute('data-slug')?.trim() || ''
      const title = tracker.getAttribute('data-title')?.trim() || ''
      const baseUrl =
        tracker.getAttribute('data-views-api-base') ||
        'https://runny.russel.is-a.dev'

      if (!slug || !title) return

      const localStorageKey = `blogs:viewed:${slug}`
      if (localStorage.getItem(localStorageKey) === '1') return

      try {
        const response = await fetch(`${baseUrl}/api/blogs/views/track`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ slug, title }),
        })

        if (response.ok) {
          localStorage.setItem(localStorageKey, '1')
        }
      } catch {
        // Ignore track failures; page rendering should not be affected.
      }
    }

    document.addEventListener('astro:page-load', () => {
      trackBlogView()


    })
  </script>
</Layout>

<style is:global>
  .blog-post-grid > :is(.blog-post-content, #toc-sidebar-container, #subposts-sidebar-container) {
    grid-row-start: var(--reading-row);
  }

  .blog-post-grid > .blog-post-return {
    grid-row-start: calc(var(--reading-row) + 1);
  }

  .blog-post-grid h1[data-return-home-heading] {
    display: flex;
    align-items: center;
    text-wrap: balance;
    min-height: 64px;
  }

  .blog-post-content { display: flow-root; }
  .blog-post-content :is(p, li) { text-align: start; }
  @media (max-width: 1279px) {
    body:has(.blog-reading-tools) .blog-post-content :is(h2,h3,h4,h5,h6,#intro-top,#top) {
      scroll-margin-top: 72px;
    }
    body:has(#mobile-toc-container):has(#mobile-subposts-container) .blog-post-content :is(h2,h3,h4,h5,h6,#intro-top,#top) {
      scroll-margin-top: 128px;
    }
  }
  .blog-post-content > #intro-top + :is(h2, h3, p),
  .blog-post-content > #top + :is(h2, h3, p) { margin-top: 0; }
  .blog-post-content > :last-child { margin-bottom: 0; }

  @media (max-width: 1199px) {
    body:has(.blog-post-main) { padding-top: 100px; }
    body:has(.blog-post-main) .site-footer { padding-top: 0; }
    .blog-post-grid h1[data-return-home-heading] { padding-left: 66px; }
  }
</style>

<script>
  if (document.querySelector('.katex')) {
    if (!document.querySelector('link[href*="katex.min.css"]')) {
      const link = document.createElement('link')
      link.rel = 'stylesheet'
      link.href =
        'https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css'
      document.head.appendChild(link)
    }
  }
</script>
