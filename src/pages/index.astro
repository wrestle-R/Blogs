---
import BlogCard from '@/components/BlogCard.astro'
import Newsletter from '@/components/Newsletter.astro'
import PageHead from '@/components/PageHead.astro'
import PaginationComponent from '@/components/ui/pagination'
import VirtualGuitar from '@/components/VirtualGuitar.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllPosts } from '@/lib/data-utils'
import Analytics from '@vercel/analytics/astro'
import { inject } from '@vercel/analytics';
const allPosts = await getAllPosts()
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const myBlogs = sortedPosts.slice(0, SITE.postsPerPage)
const totalPages = Math.max(1, Math.ceil(sortedPosts.length / SITE.postsPerPage))
const mobilePostStickers = [undefined, 'music', 'about', 'constellation', 'songbook']
---


<Layout class="max-w-4xl">
  <PageHead slot="head" title="Home" />
  
<section class="rounded-lg border bg-gradient-to-br from-background to-muted/20 relative endurance-panel">
  <a id="now-playing-badge" href="/spotify" class="listening-badge hidden">
    <span class="listening-badge__surface">
      <span id="playing-indicator" class="listening-badge__indicator animate-pulse" hidden></span>
      <svg id="badge-icon" class="listening-badge__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
      </svg>
      <span class="listening-badge__song"><span id="now-playing-text">Now playing</span></span>
      <span id="now-playing-time" class="listening-badge__time" hidden></span>
    </span>
  </a>
  
  <div class="endurance-copy flex flex-col space-y-1.5 p-5 sm:p-8">
    <div class="endurance-definition">
    <h3 class="text-3xl font-bold leading-none sm:text-4xl"><button type="button" class="endurance-trigger" data-endurance-riff disabled aria-controls="guitar" aria-pressed="false">en·dur·ance</button></h3>
    <span class="sr-only" role="status" data-endurance-status></span>
    <p class="text-muted-foreground text-sm">
      /ɛnˈdjʊərəns/ • <span class="font-medium">noun</span>
    </p>
    <p class="text-muted-foreground">
      the ability to keep going when you're tired and would rather stop.
    </p>
    </div>
  </div>
</section>

<script>
  import { SPOTIFY_API_BASE } from '../lib/spotify-api';
  let nowPlayingInterval: ReturnType<typeof setInterval> | undefined;

  function updateListeningBadge(songName: string, isPlaying: boolean, timeAgo = '') {
    const badge = document.getElementById('now-playing-badge');
    const text = document.getElementById('now-playing-text');
    const time = document.getElementById('now-playing-time');
    const indicator = document.getElementById('playing-indicator');
    const icon = document.getElementById('badge-icon');
    if (!badge || !text || !time || !indicator || !icon) return;
    const key = JSON.stringify([songName, isPlaying, timeAgo]);
    if (badge.dataset.track !== key) {
      badge.dataset.track = key;
      indicator.hidden = !isPlaying;
      time.hidden = !timeAgo;
      time.textContent = timeAgo ? `(${timeAgo})` : '';
      const label = isPlaying ? `Now playing: ${songName}` : `Last played: ${songName}${timeAgo ? `, ${timeAgo}` : ''}`;
      badge.setAttribute('aria-label', label);
      badge.title = label;
      icon.innerHTML = isPlaying
        ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />'
        : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />';
      text.textContent = songName.length > 20 ? `${songName} • ${songName} • ` : songName;
      text.classList.toggle('scrolling-text', songName.length > 20);
    }
    badge.classList.remove('hidden');
  }

  const checkLastPlayed = async () => {
    try {
      const response = await fetch(`${SPOTIFY_API_BASE}/last-played`, { cache: 'no-cache' });
      if (!response.ok) throw new Error('Last played unavailable');
      const data = await response.json();
      if (!data.name) {
        document.getElementById('now-playing-badge')?.classList.add('hidden');
        return;
      }
      const playedAt = new Date(data.playedAt).getTime();
      let timeAgo = '';
      if (Number.isFinite(playedAt)) {
        const minutes = Math.max(0, Math.floor((Date.now() - playedAt) / 60000));
        timeAgo = minutes >= 60 ? `${Math.floor(minutes / 60)}h ago` : minutes > 0 ? `${minutes}m ago` : 'Just now';
      }
      updateListeningBadge(data.name, false, timeAgo);
    } catch {
      document.getElementById('now-playing-badge')?.classList.add('hidden');
    }
  };

  const checkNowPlaying = async () => {
    try {
      const response = await fetch(`${SPOTIFY_API_BASE}/now-playing`, { cache: 'no-cache' });
      if (response.ok) {
        const data = await response.json();
        if (data.isPlaying && data.name) {
          updateListeningBadge(data.name, true);
          return;
        }
      }
    } catch { /* Keep the last-played fallback available. */ }
    await checkLastPlayed();
  };

  document.addEventListener('astro:page-load', () => {
    clearInterval(nowPlayingInterval);
    if (!document.getElementById('now-playing-badge')) return;
    void checkNowPlaying();
    nowPlayingInterval = setInterval(() => {
      if (!document.hidden) void checkNowPlaying();
    }, 15000);
  });
  document.addEventListener('astro:before-preparation', () => clearInterval(nowPlayingInterval));
</script>

<style>
  .listening-badge { position: absolute; top: 8px; right: 10px; z-index: 10; display: flex; align-items: center; width: max-content; max-width: calc(100% - 20px); min-height: 44px; color: var(--primary); text-decoration: none; }
  .listening-badge.hidden { display: none; }
  .listening-badge__surface { display: flex; align-items: center; gap: 6px; max-width: 100%; min-width: 0; height: 32px; padding: 0 12px; border-radius: 999px; background: color-mix(in srgb,var(--primary) 15%,transparent); box-shadow: 0 1px 2px #0001; }
  .listening-badge:hover .listening-badge__surface { background: color-mix(in srgb,var(--primary) 22%,transparent); }
  .listening-badge:focus-visible { outline: 2px solid var(--foreground); outline-offset: 3px; border-radius: 999px; }
  .listening-badge__indicator { flex: 0 0 8px; width: 8px; height: 8px; border-radius: 50%; background: var(--primary); }
  .listening-badge__icon { flex: 0 0 14px; width: 14px; height: 14px; }
  .listening-badge__song { display: block; flex: 0 1 auto; min-width: 0; max-width: 160px; overflow: hidden; }
  #now-playing-text { display: block; width: max-content; white-space: nowrap; font-size: 12px; line-height: 16px; font-weight: 600; }
  .listening-badge__time { flex: none; white-space: nowrap; font-size: 12px; line-height: 16px; font-weight: 500; opacity: .8; }
  .listening-badge__indicator[hidden],.listening-badge__time[hidden] { display: none; }
  .endurance-trigger { padding: 0; border: 0; background: none; color: var(--foreground); font: inherit; letter-spacing: inherit; text-align: left; min-height: 44px; transition: color 180ms ease; }
  .endurance-trigger:disabled { cursor: default; }
  .endurance-trigger:not(:disabled):hover, .endurance-trigger[aria-pressed='true'] { color: var(--primary); }
  .endurance-trigger:focus-visible { outline: 2px solid var(--primary); outline-offset: 5px; border-radius: 3px; }
  @media (min-width:640px) {
    .listening-badge { top: 12px; right: 16px; max-width: calc(100% - 32px); }
    .listening-badge__surface { height: 40px; gap: 8px; padding: 0 16px; }
    .listening-badge__icon { flex-basis: 16px; width: 16px; height: 16px; }
    .listening-badge__song { max-width: 250px; }
    #now-playing-text,.listening-badge__time { font-size: 14px; line-height: 20px; }
  }
  @media (prefers-reduced-motion:reduce) { .scrolling-text,.listening-badge__indicator { animation: none !important; } }
  @media (max-width: 639px) {
    .endurance-trigger { min-height: 0; }
    .endurance-panel { display: flex; flex-direction: column; }
    .endurance-copy { order: 0; padding: 20px; }
    .listening-badge { order: 1; position: static; align-self: flex-start; margin: -6px 20px 14px; max-width: calc(100% - 40px); }
    #guitar { display: none; }
  }
  @media (max-width: 1199px) {
    .endurance-copy { display: flow-root; }
    .endurance-copy h3 { font-size: clamp(1.25rem, 5.8vw, 2rem); }
  }
  /* Scrolling animation for long song names */
  .scrolling-text {
    animation: scroll-text 15s linear infinite;
  }

  @keyframes scroll-text {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Pause scrolling on hover to read full title */
  #now-playing-badge:hover .scrolling-text {
    animation-play-state: paused;
  }
</style>

  <div id="guitar"><VirtualGuitar /></div>


  <section class="flex flex-col gap-y-6">
    <div class="flex items-center justify-between">
      <h2 class="text-3xl font-bold">Latest Posts</h2>
      <span class="mobile-sticker-slot" data-mobile-sticker-slot="posts" aria-hidden="true"></span>
    </div>

    <div class="post-list">
      {myBlogs.length > 0 ? (
        <ul class="flex flex-col gap-y-4">
          {myBlogs.map((post, index) => (
            <li>
              <BlogCard entry={post} sticker={mobilePostStickers[index]} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground py-8 text-center">I haven't posted anything here yet.</p>
      )}
    </div>
  </section>

  <PaginationComponent currentPage={1} totalPages={totalPages} baseUrl="/blog/" firstPageUrl="/" />

  <Newsletter variant="default" position="bottom" />

</Layout>
