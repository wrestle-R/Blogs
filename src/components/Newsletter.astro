---
interface Props { title?: string; description?: string; variant?: 'default' | 'minimal' | 'card'; position?: 'top' | 'bottom' | 'inline' }
const { title = 'New posts by email', description = 'if i write something new, ill send it here as well' } = Astro.props
const apiBase = import.meta.env.PUBLIC_RUNBLOG_API_BASE_URL || 'https://runny.russel.is-a.dev'
---
<section class="newsletter-section" aria-labelledby="newsletter-heading" data-newsletter-api-base={apiBase}>
  <div class="newsletter-copy">
    <h2 id="newsletter-heading">{title}</h2>
    <p>{description}</p>
  </div>
  <form class="newsletter-form" id="newsletter-form">
    <div class="newsletter-field">
      <label class="sr-only" for="newsletter-email">Email address</label>
      <input id="newsletter-email" type="email" name="email" autocomplete="email" placeholder="your@email.com" required />
      <p class="newsletter-status" role="status">Unsubscribe whenever you want.</p>
    </div>
    <div class="sticker-inline" data-sticker-inline data-sticker-id="subscribe">
      <button type="submit" form="newsletter-form" class="subscribe-sticker" aria-label="Subscribe to new posts">
        <svg class="subscribe-sticker__icon" viewBox="0 0 32 26" fill="none" aria-hidden="true"><path d="m3 5 13-3 13 3v18H3V5Z" fill="#deedf3" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m3 5 13 10L29 5M3 23l9-9m17 9-9-9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="m14 6 3-.6" stroke="#fffdf6" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="sticker-link__label" data-subscribe-label>Subscribe</span>
      </button>
    </div>
  </form>
</section>
<script>
  let cleanup: (() => void) | undefined
  function initNewsletter() {
    cleanup?.()
    const section = document.querySelector<HTMLElement>('.newsletter-section')
    const form = section?.querySelector<HTMLFormElement>('form')
    const input = form?.querySelector<HTMLInputElement>('input')
    const button = form?.querySelector<HTMLButtonElement>('button')
    const label = button?.querySelector<HTMLElement>('[data-subscribe-label]')
    const status = section?.querySelector<HTMLElement>('.newsletter-status')
    if (!section || !form || !input || !button || !label || !status) return
    const controller = new AbortController()
    const { signal } = controller
    let timer: ReturnType<typeof setTimeout> | undefined
    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (button.disabled || !form.reportValidity()) return
      button.disabled = true
      label.textContent = 'Sending…'
      status.textContent = 'Adding your email.'
      try {
        const response = await fetch(`${section.dataset.newsletterApiBase}/api/blogs/newsletter/subscribe`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: input.value, subscribedAt: new Date().toISOString(), source: 'blogs' }), signal })
        if (!response.ok) throw new Error('Subscription failed')
        label.textContent = 'Subscribed'
        status.textContent = "You're on the list."
        input.value = ''
      } catch {
        if (signal.aborted) return
        label.textContent = 'Try again'
        status.textContent = "Couldn't subscribe. Please try again."
      } finally {
        if (!signal.aborted) timer = setTimeout(() => { button.disabled = false; label.textContent = 'Subscribe' }, 2200)
      }
    }, { signal })
    cleanup = () => { controller.abort(); clearTimeout(timer) }
  }
  document.addEventListener('astro:page-load', initNewsletter)
  document.addEventListener('astro:before-swap', () => cleanup?.())
</script>
<style>
  .newsletter-section { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,360px); align-items: center; gap: 20px; width: 100%; margin: 12px 0; padding: 18px 20px; border: 1px solid var(--border); border-radius: 10px; background: var(--background); }
  .newsletter-copy h2 { margin: 0 0 6px; font-size: 19px; line-height: 1.3; font-weight: 650; letter-spacing: -.02em; }
  .newsletter-copy p { margin: 0; font-size: 13px; line-height: 1.5; color: var(--muted-foreground); }
  .newsletter-form { display: grid; grid-template-columns: minmax(0,1fr) 84px; align-items: center; gap: 12px; min-width: 0; }
  .newsletter-field { min-width: 0; }
  input { width: 100%; min-width: 0; height: 44px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 7px; background: var(--background); color: var(--foreground); font: inherit; font-size: 13px; line-height: 1.3; }
  input:focus-visible { outline: 2px solid var(--foreground); outline-offset: 3px; }
  .newsletter-status { min-height: 18px; margin: 6px 0 0; font-size: 11px; line-height: 1.4; color: var(--muted-foreground); }
  .subscribe-sticker { position: relative; display: grid; justify-items: center; align-content: center; gap: 3px; width: 84px; min-height: 66px; padding: 7px 4px 8px; border: 1px solid #d8d2c5; border-radius: 5px 8px 5px 4px; outline: 3px solid #fffdf6; background: #fffdf6; color: #30382f; cursor: grab; box-shadow: 0 2px 0 #b9b09c80, 0 4px 7px #0002; transform: rotate(-5deg); transition: transform 180ms ease, box-shadow 180ms ease; }
  .subscribe-sticker__icon { width: 28px; height: 24px; pointer-events: none; }
  .subscribe-sticker .sticker-link__label { padding: 0; border: 0; background: none; box-shadow: none; font-size: 12px; line-height: 1.3; }
  .subscribe-sticker::before { display: none; }
  .subscribe-sticker::after { content: ''; position: absolute; right: -1px; bottom: -1px; width: 10px; height: 10px; border-radius: 0 0 4px 0; background: linear-gradient(135deg,#c9c1ae 0 45%,#f0eadc 50%); clip-path: polygon(100% 0,100% 100%,0 100%); pointer-events: none; }
  .subscribe-sticker:hover { transform: rotate(-1deg) translateY(-2px); box-shadow: 0 2px 0 #b9b09c80,0 6px 10px #0002; }
  .subscribe-sticker:active { transform: rotate(0) scale(.96); }
  .subscribe-sticker:focus-visible { outline: 2px solid var(--foreground); outline-offset: 6px; }
  .subscribe-sticker:disabled { opacity: .65; cursor: wait; }
  @media(max-width:767px) {
    .newsletter-section { grid-template-columns: 1fr; gap: 14px; padding: 18px; }
    .newsletter-form { gap: 18px; }
    input { font-size: 16px; }
  }
  @media(prefers-reduced-motion:reduce) { .subscribe-sticker { transition: none; } }
</style>
