---
import AvatarComponent from '@/components/ui/avatar'
import { Badge } from '@/components/ui/badge'
import { Separator } from '@/components/ui/separator'
import {
  getCombinedReadingTime,
  getSubpostCount,
  isSubpost,
  parseAuthors,
} from '@/lib/data-utils'
import { formatDate, getBlogRoute } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import Link from './Link.astro'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const formattedDate = formatDate(entry.data.date)
const readTime = await getCombinedReadingTime(entry.id)
const authors = await parseAuthors(entry.data.authors ?? [])
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0
const postRoute = getBlogRoute(entry.id)
const runblogApiBaseUrl =
  import.meta.env.PUBLIC_RUNBLOG_API_BASE_URL || 'https://runny.russel.is-a.dev'
---

<div
  class="hover:bg-muted/50 rounded-xl border p-4 transition-colors duration-300 ease-in-out"
  data-blog-view-card
  data-post-slug={postRoute}
  data-post-title={entry.data.title}
  data-views-api-base={runblogApiBaseUrl}
>
  <Link
    href={`/${entry.collection}/${postRoute}`}
    class="flex flex-col gap-4 sm:flex-row"
  >
    {
      entry.data.image && (
        <div class="w-full sm:max-w-3xs sm:shrink-0">
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            width={1200}
            height={630}
            class="object-cover"
          />
        </div>
      )
    }

    <div class="grow">
      <h3 class="mb-1 text-lg font-medium">{entry.data.title}</h3>
      <p class="text-muted-foreground mb-2 text-sm">{entry.data.description}</p>

      <div
        class="text-muted-foreground mb-2 flex flex-wrap items-center gap-x-2 text-xs"
      >
        {
          authors.length > 0 && (
            <>
              {authors.map((author) => (
                <div class="flex items-center gap-x-1.5">
                  <AvatarComponent
                    client:load
                    src={author.avatar}
                    alt={author.name}
                    fallback={author.name[0]}
                    className="size-5 rounded-full"
                  />
                  <span>{author.name}</span>
                </div>
              ))}
              <Separator orientation="vertical" className="h-4!" />
            </>
          )
        }
        <span>{formattedDate}</span>
        <Separator orientation="vertical" className="h-4!" />
        <span>{readTime}</span>
        <Separator orientation="vertical" className="h-4!" />
        <span class="flex items-center gap-1">
          <Icon name="lucide:eye" class="size-3" />
          <span data-blog-view-count>-- views</span>
        </span>
        {
          subpostCount > 0 && (
            <>
              <Separator orientation="vertical" className="h-4!" />
              <span class="flex items-center gap-1">
                <Icon name="lucide:file-text" class="size-3" />
                {subpostCount} subpost{subpostCount === 1 ? '' : 's'}
              </span>
            </>
          )
        }
      </div>

      {
        entry.data.tags && (
          <div class="flex flex-wrap gap-2">
            {entry.data.tags.map((tag) => (
              <Badge variant="muted" className="flex items-center gap-x-1">
                <Icon name="lucide:hash" class="size-3" />
                {tag}
              </Badge>
            ))}
          </div>
        )
      }
    </div>
  </Link>
</div>

<script>
  if (document.documentElement.dataset.blogViewCardsHydratorInitialized !== '1') {
    document.documentElement.dataset.blogViewCardsHydratorInitialized = '1'

    const updateCardViews = async () => {
      const cards = Array.from(
        document.querySelectorAll<HTMLElement>('[data-blog-view-card]'),
      )

      if (!cards.length) return

      const baseUrl =
        cards[0]?.dataset.viewsApiBase || 'https://runny.russel.is-a.dev'
      const slugs = Array.from(
        new Set(
          cards
            .map((card) => card.dataset.postSlug?.trim() || '')
            .filter(Boolean),
        ),
      )

      if (!slugs.length) return

      const params = new URLSearchParams({
        slugs: slugs.join(','),
      })

      try {
        const response = await fetch(`${baseUrl}/api/blog/views?${params}`, {
          method: 'GET',
          headers: {
            Accept: 'application/json',
          },
        })

        if (!response.ok) return

        const payload = await response.json()
        const viewMap = new Map()

        if (Array.isArray(payload?.views)) {
          payload.views.forEach((item: { slug?: string; views?: number }) => {
            if (item?.slug && Number.isFinite(item?.views)) {
              viewMap.set(item.slug, item.views)
            }
          })
        }

        cards.forEach((card) => {
          const slug = card.dataset.postSlug?.trim() || ''
          if (!slug) return

          const count = viewMap.get(slug) ?? 0
          const countNode = card.querySelector('[data-blog-view-count]')
          if (!countNode) return

          countNode.textContent = `${count} view${count === 1 ? '' : 's'}`
        })
      } catch {
        // Keep placeholder on network failure.
      }
    }

    document.addEventListener('astro:page-load', updateCardViews)
    updateCardViews()
  }
</script>
