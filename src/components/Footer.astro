---
import { Separator } from '@/components/ui/separator'
import { SOCIAL_LINKS } from '@/consts'
import Link from './Link.astro'
import SocialIcons from './SocialIcons.astro'
---

<footer data-home-footer={Astro.url.pathname === '/' ? '' : undefined}
  class="blog-footer mx-auto mb-8 flex w-full max-w-4xl flex-col items-center justify-center gap-y-2 px-4 sm:mb-4 sm:flex-row sm:justify-between"
>
  <div class="footer-meta">
  <div class="footer-copyright flex flex-wrap items-center justify-center gap-x-2 text-center">
    <span class="text-muted-foreground text-sm">
      &copy; {new Date().getFullYear()} All rights reserved.
    </span>
    <Separator orientation="vertical" className="hidden h-4! sm:block" />

  </div>
  <SocialIcons links={SOCIAL_LINKS} />
  </div>
  {Astro.url.pathname !== '/about' && <span class="mobile-sticker-slot" data-mobile-sticker-slot="about" aria-hidden="true"></span>}
  {Astro.url.pathname === '/' && <span class="mobile-sticker-slot" data-mobile-sticker-slot="songbook" aria-hidden="true"></span>}
</footer>
