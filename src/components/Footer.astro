---
import { Icon } from 'astro-icon/components'
import '@/styles/footer.css'

const footerLinks = [
  { label: 'GitHub', href: 'https://github.com/wrestle-R', icon: 'lucide:github' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/russel-daniel-970b8a303', icon: 'lucide:linkedin' },
  { label: 'Email', href: 'mailto:russeldanielpaul@gmail.com', icon: 'lucide:mail' },
]
---

<footer class="site-footer blog-footer" data-home-footer={Astro.url.pathname === '/' ? '' : undefined}>
  <div class="site-footer-frame">
    {Astro.url.pathname !== '/wallpapers' && <span class="mobile-sticker-slot site-footer-wallpapers" data-mobile-sticker-slot="wallpapers" aria-hidden="true"></span>}
    <div class="site-footer-panel">
      <p class="site-footer-copyright"><span class="site-footer-copyright-symbol">©</span><span>Running out of Excuses</span></p>
      <nav class="site-footer-connect" aria-label="Connect">
        <span class="site-footer-connect-label" aria-hidden="true">Connect</span>
        <div class="site-footer-links">
          {footerLinks.map(({ label, href, icon }) => (
            <a href={href} title={label} target={href.startsWith('https:') ? '_blank' : undefined} rel={href.startsWith('https:') ? 'noopener noreferrer' : undefined}>
              <Icon name={icon} aria-hidden="true" />
              <span class="site-footer-link-label">{label}</span>
            </a>
          ))}
        </div>
      </nav>
    </div>
  </div>
</footer>
