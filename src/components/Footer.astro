---
import '@/styles/footer.css'
const footerLinks = [
  { label: 'Email', href: 'mailto:russeldanielpaul@gmail.com' },
  { label: 'GitHub', href: 'https://github.com/wrestle-R' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/russel-daniel-970b8a303' },
]
---

<footer class="site-footer blog-footer" data-home-footer={Astro.url.pathname === '/' ? '' : undefined}>
  <div class="site-footer-panel">
    <div class="site-footer-signature">
      <p class="site-footer-copyright">© Running out of Excuses</p>
      <p class="site-footer-name"><span class="site-footer-heart">♥</span> Russel</p>
    </div>
    <nav class="site-footer-links" aria-label="Social links">
      {footerLinks.map(({ label, href }) => (
        <a href={href} target={href.startsWith('https:') ? '_blank' : undefined} rel={href.startsWith('https:') ? 'noopener noreferrer' : undefined}>{label}</a>
      ))}
    </nav>
    {Astro.url.pathname !== '/wallpapers' && <span class="mobile-sticker-slot" data-mobile-sticker-slot="wallpapers" aria-hidden="true"></span>}
  </div>
</footer>
