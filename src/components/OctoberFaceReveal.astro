<figure class="village-photos" data-october-face>
  <div class="photo-grid">
    <img class="mussel-photo" src="/blogimages/october-2026/mussels.png" alt="The mussel responsible for my new experience" loading="lazy" />
    <button class="face-frame" type="button" aria-label="Reveal my face" aria-pressed="false">
      <img src="/blogimages/october-2026/face.jpg" alt="My face after the allergic reaction" loading="lazy" />
      <span class="face-cover" aria-hidden="true">Please don't take a photo of my face, okay please and thanks.</span>
    </button>
  </div>
  <figcaption data-prompt>Tap my face if you're sure you want to see it (it's kinda scary).</figcaption>
</figure>
<style>
  .photo-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;align-items:stretch}
  .mussel-photo,.face-frame{width:100%;height:auto;aspect-ratio:4/5;border-radius:.65rem;overflow:hidden}
  .mussel-photo{display:block;object-fit:cover;object-position:center;margin:0}
  .face-frame{position:relative;padding:0;border:0;background:#171717;cursor:pointer;display:block}
  .face-frame:focus-visible{outline:3px solid currentColor;outline-offset:4px}
  .face-frame img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 48%;filter:blur(18px) brightness(1.04) saturate(.94);transform:scale(1.08);transition:filter .25s,transform .25s;margin:0}
  .face-frame.revealed img{filter:brightness(1.04) saturate(.94);transform:scale(1)}
  .face-cover{display:none;position:absolute;inset:0;background:#000;color:#fff;place-items:center;text-align:center;padding:1rem;font-size:.85rem}
  .face-frame.covered .face-cover{display:grid}
  figcaption{margin-top:.6rem}
  @media print{.face-frame{visibility:hidden}}
  @media(prefers-reduced-motion:reduce){.face-frame img{transition:none;}}
</style>
<script>
  function initFaceReveal() {
    document.querySelectorAll<HTMLElement>('[data-october-face]').forEach((root) => {
      if (root.dataset.ready) return
      root.dataset.ready = 'true'
      const frame = root.querySelector<HTMLButtonElement>('.face-frame')!
      const prompt = root.querySelector<HTMLElement>('[data-prompt]')!
      const hide = (cover = false) => {
        frame.classList.remove('revealed'); frame.classList.toggle('covered', cover)
        frame.setAttribute('aria-label', 'Reveal my face'); frame.setAttribute('aria-pressed', 'false')
        prompt.textContent = "Tap my face if you're sure you want to see it (it's kinda scary)."
      }
      frame.addEventListener('click', () => {
        if (frame.classList.contains('revealed')) { hide(); return }
        frame.classList.remove('covered'); frame.classList.add('revealed')
        frame.setAttribute('aria-label', 'Hide my face'); frame.setAttribute('aria-pressed', 'true')
        prompt.textContent = "Please don't take a photo of my face, okay please and thanks. Tap to hide."
      })
      document.addEventListener('visibilitychange', () => { if (document.hidden && frame.classList.contains('revealed')) hide(true) })
      document.addEventListener('keyup', (event) => { if (event.key === 'PrintScreen' && frame.classList.contains('revealed')) hide(true) })
    })
  }
  initFaceReveal()
  document.addEventListener('astro:page-load', initFaceReveal)
</script>
