<figure class="face-reveal" data-october-face>
  <div class="face-frame">
    <img src="/blogimages/october-2026/face.jpg" alt="My face after the allergic reaction" loading="lazy" />
    <div class="face-cover" aria-hidden="true">Please don't take a photo of my face, okay please and thanks.</div>
  </div>
  <figcaption data-prompt>Are you sure you want to look at that face? It's kinda scary and freaky.</figcaption>
  <div class="face-actions">
    <button type="button" data-ask>Look at my face</button>
    <button type="button" data-show hidden>Yes, show me</button>
    <button type="button" data-hide hidden>Hide my face</button>
  </div>
</figure>
<style>
  .face-frame{position:relative;overflow:hidden;border-radius:.5rem;max-height:520px}
  .face-frame img{display:block;width:100%;height:auto;filter:blur(22px);transform:scale(1.05);transition:filter .25s}
  .face-frame.revealed img{filter:none;transform:none}
  .face-cover{display:none;position:absolute;inset:0;background:#000;color:#fff;place-items:center;text-align:center;padding:1.5rem}
  .face-frame.covered .face-cover{display:grid}
  .face-actions{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.75rem}
  button{border:1px solid currentColor;border-radius:.5rem;padding:.65rem 1rem;cursor:pointer;background:transparent;color:inherit;font:inherit}
  button[hidden]{display:none}
  @media print{.face-frame{visibility:hidden}}
  @media(prefers-reduced-motion:reduce){.face-frame img{transition:none}}
</style>
<script>
  function initFaceReveal() {
    document.querySelectorAll<HTMLElement>('[data-october-face]').forEach((root) => {
      if (root.dataset.ready) return
      root.dataset.ready = 'true'
      const frame = root.querySelector<HTMLElement>('.face-frame')!
      const prompt = root.querySelector<HTMLElement>('[data-prompt]')!
      const ask = root.querySelector<HTMLButtonElement>('[data-ask]')!
      const show = root.querySelector<HTMLButtonElement>('[data-show]')!
      const hide = root.querySelector<HTMLButtonElement>('[data-hide]')!
      ask.addEventListener('click', () => { ask.hidden = true; show.hidden = false })
      show.addEventListener('click', () => {
        frame.classList.remove('covered'); frame.classList.add('revealed')
        show.hidden = true; hide.hidden = false
        prompt.textContent = "Please don't take a photo of my face, okay please and thanks."
      })
      hide.addEventListener('click', () => {
        frame.classList.remove('revealed', 'covered'); hide.hidden = true; ask.hidden = false
        prompt.textContent = "Are you sure you want to look at that face? It's kinda scary and freaky."
      })
      const cover = () => {
        if (!frame.classList.contains('revealed')) return
        frame.classList.remove('revealed'); frame.classList.add('covered')
        hide.hidden = true; ask.hidden = false
      }
      document.addEventListener('visibilitychange', () => { if (document.hidden) cover() })
      document.addEventListener('keyup', (event) => { if (event.key === 'PrintScreen') cover() })
    })
  }
  initFaceReveal()
  document.addEventListener('astro:page-load', initFaceReveal)
</script>
