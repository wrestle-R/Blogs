---
import ThemeToggle from './ThemeToggle.astro'
import HeadphonesSticker from './HeadphonesSticker.astro'
import '@/styles/sticker-navigation.css'

/*
 * TODO(blog): finish the designer's visual review of the sticker navigation.
 * [x] Replace the top bar and Explore menu with loose, movable object stickers.
 * [x] Keep desktop stickers large in the gutters; put fewer phone stickers in content gaps.
 * [x] Use a page-top globe/Portfolio link and place Home beside the content at every width.
 * [x] Make Back to Spotify a movable arrow sticker beside Home on the song page.
 * [x] Restore cream cutout edges and larger object artwork across phone and desktop.
 * [x] Put Minecraft near the top; fit mobile Music/About/Constellation/Songbook into post corners.
 * [x] Preserve the original headphone song; let the Music caption open Spotify.
 * [x] Use the simpler green Constellation planet and link to spotify.russel.is-a.dev.
 * [x] Restore All posts and Wallpapers; show Add a song on Home and Spotify.
 * [x] Remove Movies, Authors, Topics, Writing, compass and Collaborate navigation links.
 * [x] Keep Collaborators, existing posts and email links.
 * [x] Keep newsletter compact with breathing room, a movable Subscribe sticker and Reset icon.
 * [x] Use a plain up arrow; anchor the cloud switch to the document top with a smooth, reversible page-edge reveal.
 * [x] Rebuild About from real projects and the author's writing; use theme-matched project images.
 * [x] Remove the Spotify card background while preserving playback and preview fallbacks.
 * [ ] Get final visual approval for phone spacing, footer controls and desktop sticker placement.
 */

const local = ['localhost', '127.0.0.1'].includes(Astro.url.hostname)
const items = [
  ...(Astro.url.pathname.replace(/\/+$/, '') === '/songs' ? [{ id: 'spotify-back', order: 2, label: 'Back', href: '/spotify', image: 'back-arrow' }] : []),
  { id: 'home', order: 1, label: 'Home', href: '/', image: 'home' },
  { id: 'music', order: 3, label: 'Music', href: '/spotify', image: 'headphones' },
  { id: 'runny', order: 5, label: 'Runny', href: 'https://runny.russel.is-a.dev', image: 'running-shoe' },
  { id: 'minecraft', order: 7, label: 'Minecraft', href: local ? 'http://localhost:5173/minecraft' : 'https://minecraft.russel.is-a.dev', image: 'minecraft-wrestle' },
  { id: 'about', order: 6, label: 'About me', href: '/about', image: 'football' },
]
// Stable placement keys keep the remaining stickers in their own spaces.
const discoveries = [
  { id: 'songbook', label: 'Add a song', href: '/songs', image: 'guitar' },
  { id: 'posts', label: 'All posts', href: '/blog', image: 'blog-notebook' },
  { id: 'constellation', label: 'Constellation', href: 'https://spotify.russel.is-a.dev/', image: 'spotify-planet-polished' },
  { id: 'wallpapers', label: 'Wallpapers', href: '/wallpapers', image: 'hill-station' },
  { id: 'arch', label: 'I use Arch, btw', href: '/blog/linux-experience', image: 'arch-linux-mark' },
]

const current = (href: string) => href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname === href || Astro.url.pathname.startsWith(href + '/')
---
<nav class="sticker-navigation blog-sticker-navigation" data-sticker-navigation="blog" aria-description="Drag stickers to move them. On a phone, press and hold first. With a keyboard, use Alt and arrow keys." data-sticker-count={6 + discoveries.length} aria-label="Explore Russel’s blog">
  <a class="portfolio-return" href={local ? 'http://localhost:5173' : 'https://russeldanielpaul.is-a.dev'} aria-label="Portfolio"><span aria-hidden="true">🌐</span><span>Portfolio</span></a>
  <div class="sticker-navigation__list" data-sticker-list id="blog-sticker-links">
    {items.map((item) => (
      <div class="sticker-navigation__item" data-sticker-id={item.id} data-mobile-hidden="true" data-sticker-order={item.order} data-sticker-side={item.order < 5 ? 'left' : 'right'} style={`--sticker-row:${(item.order - 1) % 4};--sticker-angle:${[-5,6,-7,4,5,-5,3][item.order - 1]}deg`}>
        {item.id === 'music' ? <HeadphonesSticker /> : <a class="sticker-link" href={item.href} aria-label={item.id === 'spotify-back' ? 'Back to Spotify' : item.id === 'home' ? 'Blog home' : item.label} title={item.id === 'spotify-back' ? 'Back to Spotify' : item.label} aria-current={current(item.href) ? 'page' : undefined}>
          <img src={`/charms/${item.image}.${['home', 'spotify-back'].includes(item.id) ? 'svg' : 'webp'}`} alt="" width="94" height="80" draggable="false" />
          <span class="sticker-link__label">{item.id === 'home' ? <><span class="desktop-return-label">{item.label}</span><span class="mobile-return-label">Home</span></> : item.label}</span>
        </a>}
      </div>
    ))}
    <div class="sticker-navigation__item" data-sticker-id="theme" data-sticker-order="8" data-sticker-side="right" style="--sticker-row:3;--sticker-angle:-6deg">
      <ThemeToggle sticker />
    </div>
    {discoveries.map((item, index) => (
      <div class="sticker-navigation__item" data-sticker-id={item.id} data-mobile-hidden="true" data-sticker-order={index + 9} style={`--sticker-angle:${[-9,8,-11,6,-7,10][index]}deg`}>
        <a class="sticker-link" href={item.href}>
          <img src={`/charms/${item.image}.${item.id === 'arch' ? 'svg' : 'webp'}`} alt="" width="94" height="80" draggable="false" loading="lazy" />
          <span class="sticker-link__label">{item.label}</span>
        </a>
      </div>
    ))}
  </div>
  <button type="button" class="back-to-top" data-back-to-top aria-label="Back to top" title="Back to top" hidden>↑</button>
  <div class="sticker-navigation__item sticker-navigation__reset-item" data-sticker-id="reset" data-sticker-fixed hidden><button type="button" class="reset-sticker" data-sticker-reset aria-label="Reset sticker positions"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 8M4 10V4m0 6h6" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Reset</span></button></div>
</nav>
<script>
  import { initStickerNavigation } from '@/lib/sticker-navigation'
  let cleanup: (() => void) | undefined
  document.addEventListener('astro:page-load', () => {
    cleanup?.()
    const root = document.querySelector('[data-sticker-navigation="blog"]')
    if (root) cleanup = initStickerNavigation(root)
  })
  document.addEventListener('astro:before-swap', () => cleanup?.())
</script>
<style is:global>
  .blog-sticker-navigation { --sticker-foreground:var(--foreground); --sticker-muted:var(--muted-foreground); --sticker-background:var(--background); --sticker-border:var(--border); width:100%; }
</style>
