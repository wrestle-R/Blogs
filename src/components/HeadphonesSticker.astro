<div class="sticker-link headphone-sticker" data-headphone-sticker>
  <button type="button" class="headphone-sticker__play" data-headphone-play aria-label="Play Unsweetened Lemonade" title="Play Unsweetened Lemonade" aria-pressed="false" aria-describedby="headphone-status">
    <img src="/charms/headphones.webp" alt="" width="94" height="80" draggable="false" />
    <span class="headphone-sticker__indicator" aria-hidden="true"><span class="headphone-sticker__symbol"></span></span>
  </button>
  <a class="headphone-sticker__destination" href="/spotify" aria-current={Astro.url.pathname.replace(/\/$/, '') === '/spotify' ? 'page' : undefined} title="Open my Spotify feed"><span class="sticker-link__label">Music</span></a>
  <audio data-headphone-audio preload="none" src="/unsweetened_lemonade-after-14s.mp3"></audio>
  <span class="sr-only" id="headphone-status" role="status" data-headphone-status></span>
</div>
<script>
  let cleanup: (() => void) | undefined
  function initHeadphones() {
    cleanup?.()
    const sticker = document.querySelector<HTMLElement>('[data-headphone-sticker]')
    const button = sticker?.querySelector<HTMLButtonElement>('[data-headphone-play]')
    const audio = sticker?.querySelector<HTMLAudioElement>('[data-headphone-audio]')
    const status = sticker?.querySelector<HTMLElement>('[data-headphone-status]')
    if (!button || !audio || !status) return
    const controller = new AbortController()
    const { signal } = controller
    let audioFailed = false
    const update = () => {
      const playing = !audio.paused && !audio.ended
      const label = playing ? 'Pause Unsweetened Lemonade' : 'Play Unsweetened Lemonade'
      button.setAttribute('aria-pressed', String(playing))
      button.setAttribute('aria-label', label)
      button.title = label
      status.textContent = audioFailed ? 'Audio could not play. Tap the headphones to try again.' : playing ? 'Playing Unsweetened Lemonade.' : ''
    }
    const failed = () => {
      audioFailed = true
      audio.pause()
      update()
    }
    button.addEventListener('click', async () => {
      if (!audio.paused) {
        audio.pause()
        return
      }
      audioFailed = false
      if (audio.error) audio.load()
      document.querySelectorAll('audio').forEach((other) => { if (other !== audio) other.pause() })
      try {
        await audio.play()
      } catch (error) {
        if (!(error instanceof DOMException && error.name === 'AbortError')) failed()
      }
    }, { signal })
    for (const event of ['play', 'pause', 'ended']) audio.addEventListener(event, update, { signal })
    audio.addEventListener('error', failed, { signal })
    cleanup = () => { controller.abort(); audio.pause() }
  }
  document.addEventListener('astro:page-load', initHeadphones)
  document.addEventListener('astro:before-swap', () => cleanup?.())
</script>
<style is:global>
  .headphone-sticker { gap:2px; padding:0; }
  .headphone-sticker__play {
    position:relative; display:grid; place-items:center; width:100%; height:80px;
    min-height:44px; padding:0; border:0; background:transparent; color:var(--sticker-foreground); cursor:pointer;
  }
  .headphone-sticker__play::before,.headphone-sticker__play::after { display:none; }
  .headphone-sticker__play:hover { transform:none; box-shadow:none; }
  .headphone-sticker__indicator {
    position:absolute; right:8px; bottom:2px; display:grid; place-items:center;
    width:23px; height:23px; border:1px solid var(--sticker-border); border-radius:50%;
    background:var(--sticker-background); box-shadow:0 2px 5px #0003; pointer-events:none;
  }
  .headphone-sticker__symbol { width:0; height:0; margin-left:2px; border-top:4px solid transparent; border-bottom:4px solid transparent; border-left:6px solid currentColor; }
  [aria-pressed='true'] .headphone-sticker__symbol { width:7px; height:9px; margin-left:0; border:0; border-inline:2px solid currentColor; }
  .headphone-sticker__destination { display:flex; align-items:center; justify-content:center; min-width:60px; min-height:44px; text-decoration:none; }
  .headphone-sticker a[aria-current] .sticker-link__label { background:#dce8d2; border-color:#dce8d2; }
  .headphone-sticker a:hover { text-decoration:underline; text-underline-offset:3px; }
  .headphone-sticker button:focus-visible,.headphone-sticker a:focus-visible { outline:2px solid var(--sticker-foreground); outline-offset:3px; border-radius:5px; }
</style>
