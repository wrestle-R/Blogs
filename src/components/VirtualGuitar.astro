---
const strings = [
  { name: 'Low E', midi: 40 },
  { name: 'A', midi: 45 },
  { name: 'D', midi: 50 },
  { name: 'G', midi: 55 },
  { name: 'B', midi: 59 },
  { name: 'High E', midi: 64 },
]
const names = ['C', 'C♯', 'D', 'D♯', 'E', 'F', 'F♯', 'G', 'G♯', 'A', 'A♯', 'B']
const frets = Array.from({ length: 13 }, (_, fret) => fret)
const noteName = (midi: number) => `${names[midi % 12]}${Math.floor(midi / 12) - 1}`
---

<section class="guitar-section" aria-labelledby="guitar-title" data-guitar>
  <div class="guitar-heading">
    <div>
      <h2 id="guitar-title">Virtual Guitar</h2>
      <p id="guitar-help">Tap a string to play. Arrow keys move, Enter plays.</p>
    </div>
    <output class="guitar-readout" aria-live="polite" aria-atomic="true" data-guitar-note>Standard tuning</output>
  </div>
  <div class="guitar-scroll" role="group" aria-label="Guitar fretboard" aria-describedby="guitar-help guitar-scroll-help">
    <div class="guitar-neck">
      <div class="guitar-fret-numbers" aria-hidden="true">
        {frets.map((fret) => <span>{fret === 0 ? 'Open' : fret}</span>)}
      </div>
      {strings.map((string, row) => (
        <div class="guitar-string-row" style={`--string-gauge:${3 - row * .35}px`}>
          {frets.map((fret) => (
            <button
              type="button"
              class:list={['guitar-key', { 'guitar-key--open': fret === 0 }]}
              data-midi={string.midi + fret}
              data-note={noteName(string.midi + fret)}
              data-row={row}
              data-fret={fret}
              data-inlay={row === 2 && [3, 5, 7, 9, 12].includes(fret) ? '' : undefined}
              tabindex={row === 0 && fret === 0 ? 0 : -1}
              aria-label={`${string.name} string, ${fret === 0 ? 'open' : `fret ${fret}`}, ${noteName(string.midi + fret)}`}
            >
              <span class="guitar-key__note">{noteName(string.midi + fret)}</span>
            </button>
          ))}
        </div>
      ))}
    </div>
  </div>
  <p class="guitar-scroll-help" id="guitar-scroll-help">Swipe across for higher frets.</p>
</section>

<script>
  let cleanup: (() => void) | undefined

  function initGuitar() {
    cleanup?.()
    const root = document.querySelector<HTMLElement>('[data-guitar]')
    if (!root) return
    const controller = new AbortController()
    const { signal } = controller
    const keys = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-midi]'))
    const readout = root.querySelector<HTMLOutputElement>('[data-guitar-note]')
    let context: AudioContext | undefined
    const voices = new Set<AudioBufferSourceNode>()
    const timers = new Set<ReturnType<typeof setTimeout>>()

    // A plucked-string buffer is generated locally. Sound starts only after a
    // deliberate click/keypress, without downloading the old piano samples.
    async function pluck(button: HTMLButtonElement) {
      try {
        context ??= new AudioContext()
        await context.resume()
        if (signal.aborted) return
        if (context.state !== 'running') throw new Error('Audio is suspended')
        const frequency = 440 * 2 ** ((Number(button.dataset.midi) - 69) / 12)
        const delay = Math.max(2, Math.round(context.sampleRate / frequency - .5))
        const buffer = context.createBuffer(1, Math.ceil(context.sampleRate * 2.2), context.sampleRate)
        const samples = buffer.getChannelData(0)
        for (let i = 0; i <= delay; i++) samples[i] = (Math.random() * 2 - 1) * .65
        for (let i = delay + 1; i < samples.length; i++) {
          samples[i] = (samples[i - delay] + samples[i - delay - 1]) * .498
        }
        const source = context.createBufferSource()
        const gain = context.createGain()
        gain.gain.setValueAtTime(.32, context.currentTime)
        gain.gain.setTargetAtTime(0, context.currentTime + 1.5, .15)
        source.buffer = buffer
        source.connect(gain).connect(context.destination)
        // Bound polyphony when rapidly strumming on a touch screen.
        if (voices.size >= 12) voices.values().next().value?.stop()
        voices.add(source)
        source.onended = () => { voices.delete(source); source.disconnect(); gain.disconnect() }
        source.start()
        root!.dataset.audioState = context.state
        if (readout) readout.textContent = `${button.dataset.note} · ${button.dataset.fret === '0' ? 'open' : `fret ${button.dataset.fret}`}`
        button.classList.remove('is-playing')
        // Restart only this key's feedback; no layout animation for the card.
        void button.offsetWidth
        button.classList.add('is-playing')
        const timer = setTimeout(() => { button.classList.remove('is-playing'); timers.delete(timer) }, 420)
        timers.add(timer)
      } catch {
        if (!signal.aborted && readout) readout.textContent = 'Sound unavailable. Tap to try again.'
      }
    }

    function selectKey(button: HTMLButtonElement) {
      keys.forEach((key) => { key.tabIndex = key === button ? 0 : -1 })
    }
    keys.forEach((button) => {
      button.addEventListener('click', () => { selectKey(button); void pluck(button) }, { signal })
      button.addEventListener('keydown', (event) => {
        let row = Number(button.dataset.row)
        let fret = Number(button.dataset.fret)
        if (event.key === 'ArrowLeft') fret = Math.max(0, fret - 1)
        else if (event.key === 'ArrowRight') fret = Math.min(12, fret + 1)
        else if (event.key === 'ArrowUp') row = Math.max(0, row - 1)
        else if (event.key === 'ArrowDown') row = Math.min(5, row + 1)
        else if (event.key === 'Home') fret = 0
        else if (event.key === 'End') fret = 12
        else return
        event.preventDefault()
        const next = keys[row * 13 + fret]
        selectKey(next)
        next.focus({ preventScroll: true })
        next.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'instant' })
      }, { signal })
    })
    cleanup = () => {
      controller.abort()
      timers.forEach(clearTimeout)
      voices.forEach((source) => source.stop())
      void context?.close()
      cleanup = undefined
    }
  }
  document.addEventListener('astro:page-load', initGuitar)
  document.addEventListener('astro:before-swap', () => cleanup?.())
</script>

<style>
  .guitar-section {
    min-width: 0;
    padding: clamp(14px, 3vw, 24px);
    border: 1px solid var(--sk-edge);
    border-radius: 12px;
    background: linear-gradient(145deg, var(--sk-surface-raised), var(--sk-surface));
    box-shadow: var(--sk-paper-shadow);
  }
  .guitar-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 20px; margin-bottom: 18px; }
  h2 { margin: 0 0 6px; color: var(--foreground); font-size: clamp(19px, 2.5vw, 24px); font-weight: 650; letter-spacing: -.025em; }
  .guitar-heading p, .guitar-scroll-help { margin: 0; color: var(--muted-foreground); font-size: 12px; line-height: 1.6; }
  .guitar-readout { min-width: 124px; padding: 8px 12px; border: 1px solid var(--sk-edge); border-radius: 5px; background: var(--sk-well); color: var(--primary); box-shadow: inset 0 2px 3px var(--sk-shadow), 0 1px 0 var(--sk-highlight); font: 500 12px/1.5 var(--font-mono); }
  .guitar-scroll { max-width: 100%; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; scrollbar-color: var(--border) var(--sk-well); border: 1px solid var(--sk-edge); border-radius: 7px; background: var(--sk-well); box-shadow: inset 0 3px 8px var(--sk-shadow), 0 1px 0 var(--sk-highlight); }
  .guitar-neck { min-width: 576px; padding-bottom: 8px; background: repeating-linear-gradient(0deg, transparent 0 3px, color-mix(in srgb, var(--border) 14%, transparent) 3px 4px); }
  .guitar-fret-numbers, .guitar-string-row { display: grid; grid-template-columns: 48px repeat(12, minmax(44px, 1fr)); }
  .guitar-fret-numbers { padding-block: 8px 4px; color: var(--muted-foreground); font: 10px/1.5 var(--font-mono); text-align: center; }
  .guitar-key { position: relative; isolation: isolate; display: grid; place-items: center; min-width: 0; min-height: 44px; padding: 0; border: 0; border-right: 2px solid color-mix(in srgb, var(--foreground) 24%, var(--border)); border-radius: 0; background: transparent; color: var(--foreground); touch-action: pan-x pan-y; }
  .guitar-key::before { content: ''; position: absolute; z-index: -1; left: 0; right: -2px; top: 50%; height: var(--string-gauge); background: linear-gradient(var(--foreground), var(--muted-foreground)); box-shadow: 0 1px 1px var(--sk-shadow), 0 -1px 0 var(--sk-highlight); opacity: .65; }
  .guitar-key[data-inlay]::after { content: ''; position: absolute; z-index: -2; left: 50%; bottom: -3px; width: 7px; height: 7px; border-radius: 50%; background: var(--primary); opacity: .4; }
  .guitar-key--open { position: sticky; left: 0; z-index: 2; border-right: 3px solid var(--border); background: var(--card); }
  .guitar-key--open::before { display: none; }
  .guitar-key__note { padding: 2px 3px; border-radius: 3px; background: var(--card); font: 500 11px/1.5 var(--font-mono); opacity: 0; }
  .guitar-key--open .guitar-key__note, .guitar-key:focus-visible .guitar-key__note, .guitar-key.is-playing .guitar-key__note { opacity: 1; }
  .guitar-key:focus-visible { outline-offset: -4px; border-radius: 4px; }
  .guitar-key.is-playing { background: color-mix(in srgb, var(--primary) 12%, transparent); }
  .guitar-key.is-playing::before { animation: guitar-pluck 400ms ease-out; }
  .guitar-scroll-help { margin-top: 10px; }
  @media (hover: hover) { .guitar-key:hover .guitar-key__note { opacity: 1; } }
  @media (min-width: 900px) { .guitar-scroll-help { display: none; } }
  @media (max-width: 479px) { .guitar-heading { gap: 10px; } .guitar-readout { min-width: 0; } }
  @keyframes guitar-pluck { 0%, 40%, 80% { translate: 0 -1px; } 20%, 60% { translate: 0 1px; } 100% { translate: 0 0; } }
  @media (prefers-reduced-motion: reduce) { .guitar-key.is-playing::before { animation: none; } }
</style>
