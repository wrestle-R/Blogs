---
interface Props { studio?: boolean }
const { studio = false } = Astro.props
const strings = [
  { name: 'Low E', midi: 40 },
  { name: 'A', midi: 45 },
  { name: 'D', midi: 50 },
  { name: 'G', midi: 55 },
  { name: 'B', midi: 59 },
  { name: 'High E', midi: 64 },
]
const names = ['C', 'C♯', 'D', 'D♯', 'E', 'F', 'F♯', 'G', 'G♯', 'A', 'A♯', 'B']
const frets = Array.from({ length: 13 }, (_, fret) => fret)
const noteName = (midi: number) => `${names[midi % 12]}${Math.floor(midi / 12) - 1}`
---

<section class:list={['guitar-section', { 'guitar-section--studio': studio }]} aria-labelledby={studio ? 'guitar-page-title' : 'guitar-title'} data-guitar data-studio={studio ? '' : undefined}>
  {!studio && <div class="guitar-heading"><h2 id="guitar-title">Virtual Guitar</h2><a href="/guitar">Open guitar room ↗</a></div>}
  <p id="guitar-help" class="sr-only">Tap a string to play. Use arrow keys to move between visible frets and Enter to play.</p>
  <div class="guitar-neck" role="group" aria-label="Guitar fretboard" aria-describedby="guitar-help">
      {strings.map((string, row) => (
        <div class="guitar-string-row" style={`--string-gauge:${3 - row * .35}px`}>
          <svg class="guitar-string" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0 50H1000" /></svg>
          {frets.map((fret) => (
            <button
              type="button"
              class:list={['guitar-key', { 'guitar-key--open': fret === 0 }]}
              data-midi={string.midi + fret}
              data-note={noteName(string.midi + fret)}
              data-row={row}
              data-fret={fret}
              data-inlay={(row === 2 && [3, 5, 7, 9].includes(fret)) || ([1, 4].includes(row) && fret === 12) ? '' : undefined}
              tabindex={row === 0 && fret === 0 ? 0 : -1}
              aria-label={`${string.name} string, ${fret === 0 ? 'open' : `fret ${fret}`}, ${noteName(string.midi + fret)}`}
            >
              <span class="guitar-key__note">{fret === 0 ? names[string.midi % 12] : noteName(string.midi + fret)}</span>
            </button>
          ))}
        </div>
      ))}
    <output class="guitar-note-display" aria-live="polite" aria-atomic="true" data-guitar-note></output>
  </div>
</section>

<script>
  import { pluckedString } from '@/lib/guitar-riff'
  import { guitarPresets, thronesIntro, type GuitarPreset } from '@/lib/guitar-presets'
  let cleanup: (() => void) | undefined

  function initGuitar() {
    cleanup?.()
    const root = document.querySelector<HTMLElement>('[data-guitar]')
    if (!root) return
    const controller = new AbortController()
    const { signal } = controller
    const keys = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-midi]'))
    const readout = root.querySelector<HTMLOutputElement>('[data-guitar-note]')
    const trigger = document.querySelector<HTMLButtonElement>('[data-endurance-riff]')
    const status = document.querySelector<HTMLElement>('[data-endurance-status], [data-guitar-status]')
    const quizMode = !!document.querySelector('[data-guitar-quiz]')
    const notify = (state: string) => root.dispatchEvent(new CustomEvent('guitar:state', { detail: state, bubbles: true }))
    let context: AudioContext | undefined
    let output: DynamicsCompressorNode | undefined
    let master: GainNode | undefined
    let riffBus: GainNode | undefined
    const buffers = new Map<string, AudioBuffer>()
    const riffVoices = new Set<AudioBufferSourceNode>()
    const voiceGains = new Map<AudioBufferSourceNode, GainNode>()
    let riffPlaying = false
    let riffRun = 0
    let riffFrame: number | undefined
    let readoutTimer: ReturnType<typeof setTimeout> | undefined
    const voices = new Set<AudioBufferSourceNode>()
    const timers = new Map<HTMLElement, ReturnType<typeof setTimeout>>()
    const animations = new Map<SVGPathElement, number>()
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')

    function vibrate(button: HTMLButtonElement, clientX?: number) {
      const row = button.closest<HTMLElement>('.guitar-string-row')
      const string = row?.querySelector<SVGSVGElement>('.guitar-string')
      const path = string?.querySelector<SVGPathElement>('path')
      if (!string || !path) return
      const previousFrame = animations.get(path)
      if (previousFrame !== undefined) cancelAnimationFrame(previousFrame)
      path.setAttribute('d', 'M0 50H1000')
      animations.delete(path)
      if (reducedMotion.matches || !string.getBoundingClientRect().width) return

      const bounds = string.getBoundingClientRect()
      const keyBounds = button.getBoundingClientRect()
      // Use the actual pointer position; keyboard/open-string plucks use a
      // sensible point on the string. Both ends always remain anchored.
      const x = clientX ?? keyBounds.left + keyBounds.width / 2
      const pick = x < bounds.left ? 500 : Math.max(30, Math.min(970, (x - bounds.left) / bounds.width * 1000))
      const started = performance.now()
      const frame = (now: number) => {
        const elapsed = now - started
        if (elapsed >= 400 || reducedMotion.matches) {
          path.setAttribute('d', 'M0 50H1000')
          animations.delete(path)
          return
        }
        const displacement = 5 * 100 / bounds.height * Math.exp(-elapsed / 130) * Math.cos(elapsed * .09)
        const peak = 50 + displacement
        // Two smooth curves meet at the pluck point, where motion is largest.
        // Displacement falls away on either side instead of moving frets.
        path.setAttribute('d', `M0 50 C${pick * .35} 50 ${pick * .65} ${peak} ${pick} ${peak} C${pick + (1000 - pick) * .35} ${peak} ${pick + (1000 - pick) * .65} 50 1000 50`)
        animations.set(path, requestAnimationFrame(frame))
      }
      frame(started)
    }

    async function audioReady() {
      if (!context) {
        context = new AudioContext()
        output = context.createDynamicsCompressor()
        output.threshold.value = -15
        output.knee.value = 18
        output.ratio.value = 3
        output.attack.value = .003
        output.release.value = .18
        const body = context.createBiquadFilter()
        body.type = 'lowshelf'
        body.frequency.value = 180
        body.gain.value = 2
        const warmth = context.createBiquadFilter()
        warmth.type = 'highshelf'
        warmth.frequency.value = 2600
        warmth.gain.value = -4
        master = context.createGain()
        master.gain.value = quizMode ? .65 : 1
        riffBus = context.createGain()
        riffBus.gain.value = 0
        riffBus.connect(output)
        output.connect(master).connect(body).connect(warmth).connect(context.destination)
      }
      await context.resume()
      if (signal.aborted || context.state !== 'running') throw new Error('Audio unavailable')
      root!.dataset.audioState = context.state
      return context
    }

    function noteBuffer(midi: number, duration?: number) {
      // Long ties need a buffer that actually lasts until their notated release.
      const seconds = duration === undefined ? 2.5 : Math.max(2.5, Math.ceil((duration + .12) * 2) / 2)
      const key = `${midi}:${seconds}`
      let buffer = buffers.get(key)
      if (!buffer) {
        const samples = pluckedString(midi, context!.sampleRate, seconds)
        buffer = context!.createBuffer(1, samples.length, context!.sampleRate)
        buffer.getChannelData(0).set(samples)
        buffers.set(key, buffer)
      }
      return buffer
    }

    function sound(button: HTMLButtonElement, when: number, velocity = 1, riff = false, duration?: number) {
      const source = context!.createBufferSource()
      const gain = context!.createGain()
      source.buffer = noteBuffer(Number(button.dataset.midi), duration)
      gain.gain.setValueAtTime(.32 * velocity, when)
      if (duration !== undefined) {
        gain.gain.setTargetAtTime(0, when + duration, .015)
      } else gain.gain.setTargetAtTime(0, when + 1.8, .18)
      source.connect(gain).connect(riff ? riffBus! : output!)
      // Future scheduled riff voices must not evict one another before playing.
      if (!riff && voices.size >= 12) voices.values().next().value?.stop()
      voices.add(source)
      voiceGains.set(source, gain)
      if (riff) riffVoices.add(source)
      source.onended = () => { voices.delete(source); riffVoices.delete(source); voiceGains.delete(source); source.disconnect(); gain.disconnect() }
      source.start(when)
      if (duration !== undefined) source.stop(when + duration + .08)
    }

    function showPluck(button: HTMLButtonElement, clientX?: number) {
      root!.dispatchEvent(new CustomEvent('guitar:note', {detail: Number(button.dataset.row), bubbles: true}))
      if (readout) {
        readout.textContent = button.dataset.note || ''
        readout.classList.add('show')
      }
      vibrate(button, clientX)
      button.classList.add('is-playing')
      clearTimeout(timers.get(button))
      timers.set(button, setTimeout(() => { button.classList.remove('is-playing'); timers.delete(button) }, 300))
      clearTimeout(readoutTimer)
      readoutTimer = setTimeout(() => readout?.classList.remove('show'), 450)
    }

    function stopRiff(announce = true) {
      const wasPlaying = riffPlaying
      riffRun++
      riffPlaying = false
      if (riffFrame !== undefined) cancelAnimationFrame(riffFrame)
      riffFrame = undefined
      // Mute the whole score even when future sources have not started yet.
      // Individual source cancellation below also prevents a later restart.
      if (context && riffBus) {
        const now = context.currentTime
        riffBus.gain.cancelScheduledValues(now)
        riffBus.gain.setValueAtTime(riffBus.gain.value, now)
        riffBus.gain.linearRampToValueAtTime(0, now + .015)
      }
      voices.forEach(source => {
        const now = context!.currentTime
        const gain = voiceGains.get(source)!
        if (typeof gain.gain.cancelAndHoldAtTime === 'function') gain.gain.cancelAndHoldAtTime(now)
        else { gain.gain.cancelScheduledValues(now); gain.gain.setValueAtTime(gain.gain.value, now) }
        gain.gain.linearRampToValueAtTime(0, now + .025)
        source.stop(now + .03)
      })
      riffVoices.clear()
      timers.forEach(clearTimeout)
      timers.clear()
      keys.forEach(key => key.classList.remove('is-playing'))
      animations.forEach((frame, path) => { cancelAnimationFrame(frame); path.setAttribute('d', 'M0 50H1000') })
      animations.clear()
      clearTimeout(readoutTimer)
      readout?.classList.remove('show')
      readout?.setAttribute('aria-live', 'polite')
      root!.dataset.riffState = 'idle'
      notify('idle')
      trigger?.setAttribute('aria-pressed', 'false')
      trigger?.setAttribute('aria-label', 'Play endurance guitar riff')
      if (status && announce && wasPlaying) status.textContent = 'Guitar stopped.'
    }

    function audioError() {
      if (signal.aborted) return
      if (readout) {
        readout.textContent = 'Sound unavailable. Tap to try again.'
        readout.classList.add('show')
      }
      if (status) status.textContent = 'Sound unavailable. Try again.'
      notify('error')
    }

    async function pluck(button: HTMLButtonElement, clientX?: number) {
      stopRiff(false)
      try {
        const audio = await audioReady()
        sound(button, audio.currentTime)
        showPluck(button, clientX)
      } catch { audioError() }
    }

    function guitarVisible() { return quizMode || (root!.getBoundingClientRect().width > 0 && keys[0].offsetWidth > 0) }

    async function playScore(preset: GuitarPreset) {
      if (!guitarVisible() || signal.aborted) return
      stopRiff(false)
      riffPlaying = true
      const run = ++riffRun
      trigger?.setAttribute('aria-pressed', 'true')
      trigger?.setAttribute('aria-label', 'Stop endurance guitar riff')
      root!.dataset.riffState = 'starting'
      try {
        const audio = await audioReady()
        if (run !== riffRun || !guitarVisible()) return
        const notes = preset.notes
        const bpm = preset.bpm
        const beat = 60 / bpm
        notes.forEach(note => noteBuffer(Number(keys[note.row * 13 + note.fret].dataset.midi), note.durationBeats === undefined ? undefined : note.durationBeats * beat))
        // Each explicit play opens the score bus after the previous stop fade.
        // The run token prevents a cancelled async start from reopening it.
        riffBus!.gain.cancelScheduledValues(audio.currentTime)
        riffBus!.gain.setValueAtTime(0, audio.currentTime)
        riffBus!.gain.linearRampToValueAtTime(1, audio.currentTime + .03)
        const start = audio.currentTime + .06
        const end = start + preset.beats * beat + 1.2
        notes.forEach(note => sound(keys[note.row * 13 + note.fret], start + note.beat * beat, note.velocity, true, note.durationBeats === undefined ? undefined : note.durationBeats * beat))
        root!.dataset.riffState = 'playing'
        notify('playing')
        if (status) status.textContent = quizMode ? 'Listen to the guitar.' : `Playing ${preset.label}.`
        readout?.setAttribute('aria-live', 'off')
        let next = 0
        const tick = () => {
          if (signal.aborted || run !== riffRun) return
          while (next < notes.length && start + notes[next].beat * beat <= audio.currentTime) {
            const note = notes[next++]
            showPluck(keys[note.row * 13 + note.fret])
          }
          if (audio.currentTime >= end) {
            stopRiff(false)
            if (status) status.textContent = quizMode ? 'Play it again, or pick your answer.' : `${preset.label}, finished.`
          } else riffFrame = requestAnimationFrame(tick)
        }
        riffFrame = requestAnimationFrame(tick)
      } catch { stopRiff(false); audioError() }
    }

    async function playRiff() {
      if (riffPlaying || root!.dataset.riffState === 'starting') stopRiff()
      else await playScore(thronesIntro)
    }

    root.addEventListener('guitar:play', event => {
      const preset = guitarPresets.find(p => p.id === (event as CustomEvent<string>).detail)
      if (preset) void playScore(preset)
    }, { signal })
    root.addEventListener('guitar:stop', () => stopRiff(false), { signal })

    trigger?.addEventListener('click', () => { void playRiff() }, { signal })
    document.addEventListener('keydown', event => {
      if (trigger && riffPlaying) {
        if (event.target === trigger && ['Enter', ' '].includes(event.key)) event.preventDefault()
        stopRiff()
        return
      }
      if (event.key === 'Escape' && (riffPlaying || voices.size > 0)) { event.preventDefault(); stopRiff() }
    }, { signal })
    document.addEventListener('pointerdown', event => {
      if (trigger && riffPlaying && !(event.target instanceof Node && trigger.contains(event.target))) stopRiff()
    }, { signal, capture: true })
    document.addEventListener('visibilitychange', () => { if (document.hidden && (riffPlaying || voices.size > 0)) stopRiff() }, { signal })

    function selectKey(button: HTMLButtonElement) {
      keys.forEach((key) => { key.tabIndex = key === button ? 0 : -1 })
    }
    keys.forEach((button) => {
      button.addEventListener('click', (event) => { selectKey(button); void pluck(button, event.detail ? event.clientX : undefined) }, { signal })
      button.addEventListener('keydown', (event) => {
        let row = Number(button.dataset.row)
        let fret = Number(button.dataset.fret)
        const visibleFrets = keys.filter((key) => Number(key.dataset.row) === row && key.offsetWidth > 0)
        const lastFret = Number(visibleFrets.at(-1)?.dataset.fret || 0)
        if (event.key === 'ArrowLeft') fret = Math.max(0, fret - 1)
        else if (event.key === 'ArrowRight') fret = Math.min(lastFret, fret + 1)
        else if (event.key === 'ArrowUp') row = Math.max(0, row - 1)
        else if (event.key === 'ArrowDown') row = Math.min(5, row + 1)
        else if (event.key === 'Home') fret = 0
        else if (event.key === 'End') fret = lastFret
        else return
        event.preventDefault()
        const next = keys[row * 13 + fret]
        selectKey(next)
        next.focus({ preventScroll: true })
      }, { signal })
    })
    // A smaller viewport removes frets instead of adding a scrollable panel.
    // Keep the one keyboard entry point on a visible key after resizing.
    const resizeObserver = new ResizeObserver(() => {
      const visible = guitarVisible()
      if (trigger) {
        trigger.disabled = !visible
        if (visible) trigger.setAttribute('aria-label', riffPlaying ? 'Stop endurance guitar riff' : 'Play endurance guitar riff')
        else trigger.removeAttribute('aria-label')
      }
      if (!visible && (riffPlaying || voices.size > 0)) stopRiff()
      const selected = keys.find((key) => key.tabIndex === 0)
      if (selected && selected.offsetWidth === 0) {
        const open = keys[Number(selected.dataset.row) * 13]
        selectKey(open)
        if (document.activeElement === selected) open.focus({ preventScroll: true })
      }
    })
    resizeObserver.observe(root)
    cleanup = () => {
      stopRiff(false)
      if (trigger) trigger.disabled = true
      resizeObserver.disconnect()
      controller.abort()
      timers.forEach(clearTimeout)
      animations.forEach((frame, path) => { cancelAnimationFrame(frame); path.setAttribute('d', 'M0 50H1000') })
      voices.forEach((source) => source.stop())
      void context?.close()
      cleanup = undefined
    }
  }
  document.addEventListener('astro:page-load', initGuitar)
  document.addEventListener('astro:before-swap', () => cleanup?.())
</script>

<style>
  .guitar-section { min-width: 0; container-type: inline-size; margin-block: 8px; }
  h2 { margin: 0 0 22px; color: var(--foreground); font-size: 30px; font-weight: 700; letter-spacing: -.035em; }
  .guitar-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .guitar-heading a { color: var(--muted-foreground); font-size: 12px; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .guitar-heading a:hover { color: var(--primary); }
  .show-note-labels .guitar-key__note { opacity: 1; font-size: 10px; background: var(--card); }
  .guitar-neck { position: relative; overflow: hidden; padding-block: 22px; border-radius: 10px; background: transparent; }
  .guitar-string-row { position: relative; isolation: isolate; --open-width: 48px; display: grid; grid-template-columns: var(--open-width) 1.89fr 1.78fr 1.68fr 1.59fr 1.5fr 1.41fr 1.33fr 1.26fr 1.19fr 1.12fr 1.06fr 1fr; }
  .guitar-key { position: relative; isolation: isolate; display: grid; place-items: center; min-width: 0; min-height: 46px; padding: 0; border: 0; border-right: 1px solid color-mix(in srgb, var(--foreground) 14%, transparent); border-radius: 0; background: transparent; color: var(--foreground); touch-action: manipulation; }
  .guitar-string { position: absolute; z-index: -1; left: var(--open-width); top: 0; width: calc(100% - var(--open-width)); height: 100%; overflow: visible; opacity: .8; pointer-events: none; }
  .guitar-string path { fill: none; stroke: var(--muted-foreground); stroke-width: var(--string-gauge); vector-effect: non-scaling-stroke; }
  .guitar-key[data-inlay]::after { content: ''; position: absolute; z-index: -2; left: 50%; bottom: -5px; width: 10px; height: 10px; border-radius: 50%; background: var(--muted-foreground); opacity: .28; }
  .guitar-key--open { border-right: 2px solid color-mix(in srgb, var(--foreground) 18%, transparent); }
  .guitar-key__note { padding: 2px 3px; border-radius: 3px; font: 500 11px/1.5 var(--font-mono); opacity: 0; }
  .guitar-key--open .guitar-key__note { font: 650 17px/1.5 var(--font-sans); }
  .guitar-key--open .guitar-key__note, .guitar-key:focus-visible .guitar-key__note { opacity: 1; }
  .guitar-key:focus-visible .guitar-key__note { background: var(--card); }
  .guitar-key.is-playing .guitar-key__note { opacity: 1; background: var(--primary); color: var(--primary-foreground); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 12%, transparent); }
  .guitar-key:focus-visible { outline-offset: -4px; border-radius: 4px; }
  .guitar-note-display { position: absolute; inset: 50% auto auto 50%; translate: -50% -50%; max-width: 90%; color: var(--foreground); font-size: clamp(24px, 8vw, 48px); font-weight: 650; text-align: center; opacity: 0; pointer-events: none; }
  .guitar-note-display.show { opacity: .85; }
  @container (max-width: 799px) {
    .guitar-string-row { --open-width: 44px; grid-template-columns: var(--open-width) repeat(10, minmax(0, 1fr)); }
    .guitar-key:nth-of-type(n+12) { display: none; }
  }
  @container (max-width: 639px) {
    .guitar-string-row { --open-width: 44px; grid-template-columns: var(--open-width) repeat(8, minmax(0, 1fr)); }
    .guitar-key:nth-of-type(n+10) { display: none; }
  }
  @container (max-width: 479px) {
    h2 { font-size: 24px; margin-bottom: 16px; }
    .guitar-neck { padding-block: 12px; }
    .guitar-string-row { --open-width: 40px; grid-template-columns: var(--open-width) repeat(5, minmax(0, 1fr)); }
    .guitar-key { min-height: 44px; }
    .guitar-key:nth-of-type(n+7) { display: none; }
  }
</style>
