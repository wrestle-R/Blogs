---
interface Props { sticker?: boolean }
---
<button id="theme-toggle" type="button" class="theme-switch" data-theme-switch role="switch" aria-checked="true" aria-label="Lights" title="Turn the lights off">
  <span class="theme-switch__plate" aria-hidden="true"><span class="theme-switch__socket"><span class="theme-switch__rocker"><span class="theme-switch__light"></span></span></span></span>
</button>

<script is:inline data-astro-rerun>
  (() => {
    const THEME_KEY = 'theme'
    const VALID_THEMES = new Set(['dark', 'light'])

    const getCookieDomain = () => {
      const host = window.location.hostname
      if (!host || host === 'localhost' || host === '127.0.0.1' || host === '::1') return ''
      if (host === 'russeldanielpaul.is-a.dev' || host.endsWith('.russeldanielpaul.is-a.dev')) return '.russeldanielpaul.is-a.dev'
      return ''
    }

    const readThemeCookie = () => {
      const cookie = document.cookie.split('; ').find((row) => row.startsWith(`${THEME_KEY}=`))
      return cookie ? decodeURIComponent(cookie.split('=')[1]) : ''
    }

    const writeThemeCookie = (theme) => {
      const maxAge = 60 * 60 * 24 * 365
      const domain = getCookieDomain()
      const domainPart = domain ? `; domain=${domain}` : ''
      document.cookie = `${THEME_KEY}=${encodeURIComponent(theme)}; path=/; max-age=${maxAge}; samesite=lax${domainPart}`
    }

    const getPreferredTheme = () => {
      const fromCookie = readThemeCookie()
      if (VALID_THEMES.has(fromCookie)) return fromCookie

      const fromStorage = window.localStorage.getItem(THEME_KEY) ?? ''
      if (VALID_THEMES.has(fromStorage)) return fromStorage

      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    }

    const initialTheme = getPreferredTheme()
    document.documentElement.setAttribute('data-theme', initialTheme)
    window.localStorage.setItem(THEME_KEY, initialTheme)
    writeThemeCookie(initialTheme)
    document.getElementById('theme-toggle')?.setAttribute('aria-checked', String(initialTheme === 'light'))
  })()
</script>

<script>
  // @ts-nocheck
  const THEME_KEY = 'theme'

  function getCookieDomain() {
    const host = window.location.hostname
    if (!host || host === 'localhost' || host === '127.0.0.1' || host === '::1') return ''
    if (host === 'russeldanielpaul.is-a.dev' || host.endsWith('.russeldanielpaul.is-a.dev')) return '.russeldanielpaul.is-a.dev'
    return ''
  }

  function writeThemeCookie(theme) {
    const maxAge = 60 * 60 * 24 * 365
    const domain = getCookieDomain()
    const domainPart = domain ? `; domain=${domain}` : ''
    document.cookie = `${THEME_KEY}=${encodeURIComponent(theme)}; path=/; max-age=${maxAge}; samesite=lax${domainPart}`
  }

  function applyTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme)
    localStorage.setItem(THEME_KEY, theme)
    writeThemeCookie(theme)
    const button = document.getElementById('theme-toggle')
    button?.setAttribute('aria-checked', String(theme === 'light'))
    button?.setAttribute('title', theme === 'dark' ? 'Turn the lights on' : 'Turn the lights off')
  }

  function isEditableTarget(target) {
    if (!(target instanceof HTMLElement)) return false
    const tag = target.tagName.toLowerCase()
    return target.isContentEditable || tag === 'input' || tag === 'textarea' || tag === 'select'
  }

  function toggleTheme(sourceEl = null) {
    const element = document.documentElement
    const currentTheme = element.getAttribute('data-theme')
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark'

    const supportsViewTransition = typeof document.startViewTransition === 'function' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (!supportsViewTransition || !sourceEl || !(sourceEl instanceof HTMLElement)) {
      applyTheme(newTheme)
      return
    }

    if (element.classList.contains('theme-transition')) return
    const rect = sourceEl.getBoundingClientRect()
    const x = rect.left + rect.width / 2
    const y = rect.top + rect.height / 2
    const endRadius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))
    element.style.setProperty('--theme-transition-x', `${x}px`)
    element.style.setProperty('--theme-transition-y', `${y}px`)
    element.style.setProperty('--theme-transition-radius', `${endRadius}px`)
    element.classList.add('theme-transition')
    const cleanup = () => {
      element.classList.remove('theme-transition')
      element.style.removeProperty('--theme-transition-x')
      element.style.removeProperty('--theme-transition-y')
      element.style.removeProperty('--theme-transition-radius')
    }
    try {
      const transition = document.startViewTransition(() => applyTheme(newTheme))
      transition.finished.then(cleanup, cleanup)
    } catch {
      cleanup()
      applyTheme(newTheme)
    }
  }

  function handleToggleClick(event) {
    toggleTheme(event.currentTarget)
  }

  function handleThemeKeydown(event) {
    if (event.repeat) return
    if (event.key.toLowerCase() !== 'd') return
    if (isEditableTarget(event.target)) return
    event.preventDefault()
    toggleTheme(document.getElementById('theme-toggle'))
  }

  function initThemeToggle() {
    const toggleBtn = document.getElementById('theme-toggle')
    toggleBtn?.removeEventListener('click', handleToggleClick)
    toggleBtn?.addEventListener('click', handleToggleClick)
    applyTheme(document.documentElement.getAttribute('data-theme') || 'light')

    window.removeEventListener('keydown', handleThemeKeydown)
    window.addEventListener('keydown', handleThemeKeydown)
  }

  initThemeToggle()

  document.addEventListener('astro:after-swap', () => {
    const storedTheme = localStorage.getItem(THEME_KEY) || 'light'
    applyTheme(storedTheme)
    initThemeToggle()
  })
</script>
